APP_NAME="Atrina BaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

# Infra-provided PostgreSQL (do not run Postgres in app compose)
DB_CONNECTION=pgsql
DB_HOST=db.internal.example
DB_PORT=5432
DB_DATABASE=atrina_baas
DB_USERNAME=atrina
DB_PASSWORD=change-me
# DB_SSLMODE=require

# Infra-provided Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis.internal.example
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=app.example.com

# SMS.ir (OTP) — optional
SMSIR_ENABLED=false
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_OTP_TTL_SECONDS=120
SMSIR_OTP_LENGTH=6
SMSIR_OTP_RESEND_SECONDS=60

# Google Sign-In — optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
