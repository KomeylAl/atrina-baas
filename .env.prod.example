# Root env for docker compose -f docker-compose.prod.yml
# Copy to .env.prod and fill with real infra values. Never commit .env.prod.

IMAGE_TAG=latest
ENV_FILE=.env.prod

# Host ports when not using the Caddy profile
API_HOST_PORT=8080
DASHBOARD_HOST_PORT=3000

# Built into the dashboard image at build time
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://app.example.com

# Optional Caddy profile (docker compose --profile with-caddy ...)
API_DOMAIN=api.example.com
DASHBOARD_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

RUN_MIGRATIONS_ON_START=false
CACHE_CONFIG_ON_START=true

# ---- Laravel runtime (same keys as atrina-baas-backend/.env.production.example) ----
APP_NAME=Atrina BaaS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db.internal.example
DB_PORT=5432
DB_DATABASE=atrina_baas
DB_USERNAME=atrina
DB_PASSWORD=change-me

REDIS_CLIENT=phpredis
REDIS_HOST=redis.internal.example
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis

SANCTUM_STATEFUL_DOMAINS=app.example.com

SMSIR_ENABLED=false
GOOGLE_CLIENT_ID=
