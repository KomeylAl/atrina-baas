# Copy to deploy/env on the server. Do not commit deploy/env.
#
# Hostnames must be the existing service names on the infrastructure network.
# localhost inside the container is the container itself.

DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/atrina
REDIS_URL=redis://redis:6379

# false while the app is reached over plain HTTP on port 5050.
# Set true when a reverse proxy terminates HTTPS.
COOKIE_SECURE=false

# Docker Compose reads this from the project .env or the shell, not from this file.
# INFRA_NETWORK=infrastructure
